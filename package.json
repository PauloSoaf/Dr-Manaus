{
  "name": "dr-manaus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "test:browser:manaus": "node scripts/manaus-surface-browser.mjs",
    "test:browser:space": "node scripts/space-hardening-browser.mjs",
    "test:browser:volume": "node scripts/volume-meshing-browser.mjs",
    "benchmark:volume": "node --import tsx scripts/benchmark-volume.mjs",
    "benchmark:impact": "node --import tsx scripts/benchmark-impact.mjs",
    "benchmark:impact-volume": "node --import tsx scripts/benchmark-impact-volume.mjs",
    "check:impact-fidelity": "node --import tsx scripts/measure-crater-fidelity.mjs",
    "profile": "node scripts/profile-flight.mjs",
    "assets:player": "node scripts/build-player-character.mjs",
    "validate:player": "node scripts/validate-player-glb.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
